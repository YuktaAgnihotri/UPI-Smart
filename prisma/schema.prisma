generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"

}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  username  String

  dailyanalyzedReport DailyanalyzedReport[]
}

model passwordReset {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model DailyanalyzedReport{
  id      String   @id @default(cuid())
  userId     String   
  date String //YYYY-MM-DD
 transactions Json 
 summary Json
 userNotes     String?
  insights String
  suggestions Json
  savingTips Json
  createdAt DateTime @default(now())
user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])

}